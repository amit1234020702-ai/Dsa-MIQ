class Solution {
    public boolean containsDuplicate(int[] nums) {

        Arrays.sort(nums);

        int left = 0;
        int right = 1;

        while (right < nums.length) {

            if (nums[left] == nums[right]) {
                return true;
            }

            left++;
            right++;
        }

        return false;
    }
}
T:O(n log n)
S:O(n)

